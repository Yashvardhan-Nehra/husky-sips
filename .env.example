# Copy to .env.local (never commit real values).

# Public site URL used for canonical links and share URLs.
VITE_SITE_URL=https://example.com

# Form submission endpoint. Must accept JSON POST and reply 2xx with {"ok":true}.
# Leave unset to show the honest "enquiries not connected yet" state.
VITE_FORMS_ENDPOINT=

# Optional analytics endpoint (JSON POST via sendBeacon). Leave unset to log in dev only.
VITE_ANALYTICS_ENDPOINT=

# Optional Cloudflare Turnstile site key for spam protection (public key, safe in client).
VITE_TURNSTILE_SITE_KEY=

# Show draft (unapproved) recipes/content on staging builds. Default: only in `vite dev`.
VITE_PREVIEW_DRAFTS=false
